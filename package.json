{
  "name": "rms",
  "private": true,
  "description": "Restaurant Management System workspace scripts",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix admin-web && npm install --prefix desktop-pos",
    "dev": "concurrently --kill-others-on-fail --names API,ADMIN \"npm:dev:backend\" \"npm:dev:admin\"",
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm start --prefix backend",
    "dev:admin": "npm run dev --prefix admin-web",
    "dev:desktop": "npm run dev --prefix desktop-pos",
    "build:admin": "npm run build --prefix admin-web",
    "build:desktop": "npm run build --prefix desktop-pos",
    "test:backend": "npm test --prefix backend",
    "check:backend": "node --check backend/server.js && node --check backend/src/app.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
