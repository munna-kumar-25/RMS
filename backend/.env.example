# Server
PORT=5000
NODE_ENV=development

# Database. MONGODB_URI is required. Do not commit a real .env file.
MONGODB_URI=mongodb://127.0.0.1:27017/rms

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Required. Use a random string of at least 32 characters. Do not commit the real value.
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
SESSION_COOKIE_NAME=rms.sid
SESSION_TTL_MINUTES=480

# Required only to configure per-branch Paytm / PhonePe credentials.
# Generate a unique 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep it backed up; changing it makes stored gateway credentials unreadable.
PAYMENT_GATEWAY_ENCRYPTION_KEY=
# Public HTTPS origin of this backend, used for provider return and Paytm hosted checkout.
PAYMENT_GATEWAY_PUBLIC_URL=

# Set only to the number of trusted reverse-proxy hops, for example 1.
# Leave empty for local development. Do not set this to true.
TRUST_PROXY=

# Password-reset links are not part of the current session design.
FRONTEND_URL=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000

# SMTP password reset email service
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Customer mobile OTP login (MSG91)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91

# Redis is optional. The API starts when Redis is down.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
