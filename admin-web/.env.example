# Optional. Leave unset in local development to use the Vite /api proxy.
# The value must include the /api/v1 prefix when set to an absolute URL.
# VITE_API_URL=http://127.0.0.1:5000/api/v1

# Used only by the Vite dev server proxy. Not read by browser code.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Optional. Backend port is read from ../backend/.env when this is unset.
# VITE_DESKTOP_BACKEND_URL=http://127.0.0.1:5000
